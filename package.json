{
  "name": "@zakkster/lite-fastbit32",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "version": "1.2.0",
  "description": "Zero-GC, monomorphic 32-bit flag manager and ECS masking primitive for high-performance game loops.",
  "type": "module",
  "sideEffects": false,
  "main": "./FastBit32.js",
  "module": "./FastBit32.js",
  "types": "./FastBit32.d.ts",
  "exports": {
    ".": {
      "types": "./FastBit32.d.ts",
      "node": "./FastBit32.js",
      "import": "./FastBit32.js",
      "default": "./FastBit32.js"
    }
  },
  "files": [
    "FastBit32.js",
    "FastBit32.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/PeshoVurtoleta/lite-fastbit32#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-fastbit32.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-fastbit32/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bitflags",
    "bitmask",
    "bitmap",
    "bitwise",
    "state-machine",
    "ecs",
    "gamedev",
    "engine",
    "performance",
    "branchless",
    "zero-gc",
    "fast",
    "32bit",
    "flags",
    "bit-operations",
    "low-level",
    "realtime",
    "rendering",
    "pipeline",
    "lite-tools",
    "fastbit32"
  ],
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-perf-gate": "^1.4.3",
    "@zakkster/lite-signal": "^1.5.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "torture": "node --expose-gc --min-semi-space-size=4 --max-semi-space-size=4 test/torture.mjs",
    "torture:controls": "node --expose-gc --min-semi-space-size=4 --max-semi-space-size=4 test/torture/controls-runner.mjs",
    "test:perf": "node --expose-gc --min-semi-space-size=4 --max-semi-space-size=4 --test test/perf/PerfGate.test.mjs",
    "bundle-check": "esbuild FastBit32.js --bundle --format=esm --outfile=.bundle-check/test-bundle.js",
    "verify": "npm test && npm run test:types && npm run torture && npm run torture:controls && npm run test:perf",
    "prepublishOnly": "npm run verify && npm run bundle-check"
  }
}
